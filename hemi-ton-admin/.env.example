# ==============================================================================
# HEMI TON ADMIN PANEL — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# Do NOT place production secrets or ZeParty credentials in this file.

# Application Branding
VITE_APP_TITLE=Hemi Ton Admin
VITE_APP_VERSION=1.0.0

# Hemi Ton Backend API Base URL
# Development backend defaults to isolated local port 5000 (do NOT point to ZeParty)
VITE_API_BASE_URL=http://localhost:5000/api

# Proxy target for Vite dev server
VITE_BACKEND_PROXY_TARGET=http://localhost:5000

# Mock Mode: When true, provides local mock responses with a visible banner
# if the Hemi Ton backend is not yet running or endpoints are under development.
VITE_USE_MOCK_API=true

# Request Timeout (ms)
VITE_API_TIMEOUT=30000
