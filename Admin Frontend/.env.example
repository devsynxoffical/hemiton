# ==============================================================================
# HEMI TON — Admin Portal Environment Configuration Example
# ==============================================================================

# Set to false to connect directly to live backend REST APIs
VITE_BACKEND_DISCONNECTED=false

# Live Railway backend API base URL
VITE_API_BASE_URL=https://hemi-ton-backend-production.up.railway.app/api

# Vite dev proxy target
VITE_PROXY_TARGET=https://hemi-ton-backend-production.up.railway.app
