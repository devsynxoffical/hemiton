# ==============================================================================
# HEMI TON — Backend Environment Configuration Example
# ==============================================================================

NODE_ENV=development
PORT=8080

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hemiton
PRISMA_LOG_QUERIES=false

# Cache and Realtime (Redis)
REDIS_URL=redis://localhost:6379

# Client CORS & Public API
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://hemi-ton-backend-production.up.railway.app,https://hemiton.live,https://admin.hemiton.live,*
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://hemi-ton-backend-production.up.railway.app,https://hemiton.live,https://admin.hemiton.live,*
PUBLIC_API_URL=https://hemi-ton-backend-production.up.railway.app

# Authentication & Security
JWT_SECRET=super-secret-hemiton-jwt-key-change-in-prod-2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# OTP Communications
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=5

# Encryption Master Keys
PAYMENT_ENCRYPTION_KEY=hemiton-payment-encryption-master-key-32b!
OTP_ENCRYPTION_KEY=hemiton-otp-encryption-master-key-32b!

# Agora Realtime Streaming & Calling
AGORA_APP_ID=mock_agora_app_id_test_environment_12345
AGORA_APP_CERTIFICATE=mock_agora_app_cert_test_environment_67890
AGORA_TOKEN_EXPIRY_SECONDS=3600
AGORA_MOCK_MODE=false

# Realtime Socket.IO
SOCKET_REDIS_ENABLED=false

# Bootstrap Administrative Credentials
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@hemiton.live
SUPER_ADMIN_PASSWORD=admin123
OWNER_EMAIL=owner@hemiton.live
OWNER_PASSWORD=owner123
